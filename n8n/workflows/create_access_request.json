    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? {};\n\nconst system = body.system;\nconst role = body.role;\n\nif (\n  typeof system !== 'string' ||\n  !system.trim()\n) {\n  throw new Error(\n    'system must be a non-empty string'\n  );\n}\n\nif (\n  typeof role !== 'string' ||\n  !role.trim()\n) {\n  throw new Error(\n    'role must be a non-empty string'\n  );\n}\n\nreturn [\n  {\n    json: {\n      system: system.trim(),\n      role: role.trim(),\n      validated: true,\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "064cae59-935a-4516-b1ca-05a72081a2ef",
      "name": "Validate Access Request"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nconst requestId = [\n  'AR',\n  Date.now().toString(36).toUpperCase(),\n  Math.random()\n    .toString(36)\n    .slice(2, 6)\n    .toUpperCase(),\n].join('-');\n\nreturn [\n  {\n    json: {\n      request_id: requestId,\n      system: input.system,\n      role: input.role,\n      status: 'submitted',\n      created_at: new Date().toISOString(),\n    },\n  },\n];"
      },
